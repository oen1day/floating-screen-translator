<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="34dp"
        android:paddingRight="24dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLOATING OCR"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:letterSpacing="0.18" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="浮屏译"
            android:textColor="@color/paper"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="捕获屏幕文字，在可拖动、可缩放的悬浮窗里持续翻译。"
            android:textColor="@color/paper_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运行状态"
                android:textColor="@color/paper"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="正在检查权限…"
                android:textColor="@color/paper_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/permission_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="悬浮窗权限：检查中"
                android:textColor="@color/warning"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="首次使用"
            android:textColor="@color/paper"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="1. 授予悬浮窗和通知权限\n2. 点击下方按钮并允许屏幕捕获\n3. 在悬浮面板打开“翻译”\n4. 默认翻译全屏；需要时点击“框选区域”"
            android:textColor="@color/paper_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="7dp" />

        <Button
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/button_primary"
            android:text="授权并启动悬浮翻译"
            android:textAllCaps="false"
            android:textColor="@color/ink_950"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accessibility_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="HyperOS 兼容模式：正在检查无障碍状态…"
            android:textColor="@color/paper_muted"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/accessibility_mode_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_secondary"
            android:text="使用无障碍兼容模式"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/local_model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="本地精修模型：检查中…"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/local_model_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:text="下载本地精修模型"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/large_model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="3B 精细模型：检查中，模型与缓存合计约 3.5GB…"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/large_model_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:text="下载 3B 精细模型"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ultra_model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="日→中专项模型：检查中…"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/ultra_model_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:text="下载 Sakura 7B 日→中专项模型"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/api_settings_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="API 翻译：未配置"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="API 服务商"
            android:textColor="@color/paper_muted"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/api_provider_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />

        <EditText
            android:id="@+id/api_endpoint_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:background="@drawable/card_bg"
            android:hint="完整的 HTTPS Chat Completions URL"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:saveEnabled="false"
            android:textColor="@color/paper"
            android:textColorHint="@color/paper_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/api_model_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:background="@drawable/card_bg"
            android:hint="模型名称，例如 gpt-4o-mini 或 deepseek-chat"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:saveEnabled="false"
            android:textColor="@color/paper"
            android:textColorHint="@color/paper_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/api_key_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:background="@drawable/card_bg"
            android:hint="填写 API Key"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:saveEnabled="false"
            android:textColor="@color/paper"
            android:textColorHint="@color/paper_muted"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/api_consent_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="我知道选择 API 档时，屏幕识别文字会发送到填写的外部服务，并可能产生费用"
            android:textColor="@color/paper_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/api_save_button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:text="保存 API 设置"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/vip_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="ADB 辅助自动恢复：检查中…"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/vip_button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:text="ADB 辅助自动恢复"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="13sp" />

        <Button
            android:id="@+id/stop_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_secondary"
            android:text="停止悬浮服务"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="隐私说明：OCR 与翻译默认在设备上运行。仅首次下载语言模型时需要联网；受保护或禁止录制的画面可能显示为黑屏。"
            android:textColor="#8FA7AD"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
