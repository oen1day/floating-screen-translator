<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="34dp"
        android:paddingRight="24dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLOATING OCR"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:letterSpacing="0.18" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/app_name"
            android:textColor="@color/paper"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tagline"
            android:textColor="@color/paper_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/interface_language_button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_secondary"
            android:text="@string/interface_language"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/run_status"
                android:textColor="@color/paper"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/status_checking"
                android:textColor="@color/paper_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/permission_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/overlay_permission_checking"
                android:textColor="@color/warning"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/first_use"
            android:textColor="@color/paper"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="@string/first_use_steps"
            android:textColor="@color/paper_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="7dp" />

        <Button
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/button_primary"
            android:text="@string/start_button"
            android:textAllCaps="false"
            android:textColor="@color/ink_950"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accessibility_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/accessibility_checking"
            android:textColor="@color/paper_muted"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/accessibility_mode_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_secondary"
            android:text="@string/use_accessibility"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/local_model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/local_model_checking"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/local_model_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:text="@string/download_local_model"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/large_model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/large_model_checking"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/large_model_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:text="@string/download_large_model"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ultra_model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/ultra_model_checking"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/ultra_model_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:text="@string/download_ultra_model"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/api_settings_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/api_unconfigured"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/api_provider"
            android:textColor="@color/paper_muted"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/api_provider_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />

        <EditText
            android:id="@+id/api_endpoint_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:background="@drawable/card_bg"
            android:hint="@string/api_endpoint_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:saveEnabled="false"
            android:textColor="@color/paper"
            android:textColorHint="@color/paper_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/api_model_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:background="@drawable/card_bg"
            android:hint="@string/api_model_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:saveEnabled="false"
            android:textColor="@color/paper"
            android:textColorHint="@color/paper_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/api_key_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:background="@drawable/card_bg"
            android:hint="@string/api_key_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:saveEnabled="false"
            android:textColor="@color/paper"
            android:textColorHint="@color/paper_muted"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/api_consent_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/api_consent"
            android:textColor="@color/paper_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/api_save_button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:text="@string/save_api_settings"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/vip_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/adb_recovery_checking"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/vip_button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:text="@string/adb_recovery"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="13sp" />

        <Button
            android:id="@+id/stop_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_secondary"
            android:text="@string/stop_service"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/privacy_note"
            android:textColor="#8FA7AD"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/project_credit"
            android:textColor="@color/aqua"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
